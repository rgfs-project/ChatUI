# ChatUI configuration. Copy to .env for local development; never commit .env.
# Every variable is validated once at startup; an invalid value stops the server
# with a clear message.

# HTTP port. 0 = ephemeral.
PORT=3000

# Persistent data directory (must already exist). Nothing writes to it yet.
DATA_DIR=./data

# development | production | test
NODE_ENV=development

# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# Interface the server listens on. Outside the container image this must be a
# loopback address (127.0.0.1 or ::1) until authentication ships in Phase 4.
# The container image sets 0.0.0.0 and Compose publishes on 127.0.0.1 only.
LISTEN_HOST=127.0.0.1

# ---- Compose only (compose.yaml) ----
# Host port published on 127.0.0.1.
# HOST_PORT=3000
# Name of the persistent /data volume.
# CHATUI_VOLUME=chatui-data
