# ChatUI configuration. Copy to .env for local development; never commit .env.
# Every variable is validated once at startup; an invalid value stops the server
# with a clear message.

# HTTP port. Phase 1a always binds to 127.0.0.1 (loopback only). 0 = ephemeral.
PORT=3000

# Persistent data directory (must already exist). Nothing writes to it in Phase 1a.
DATA_DIR=./data

# development | production | test
NODE_ENV=development

# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info
