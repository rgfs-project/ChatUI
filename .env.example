# ChatUI configuration. Copy to .env for local development; never commit .env.
# Every variable is validated once at startup; an invalid value stops the server
# with a clear message.

# HTTP port. 0 = ephemeral.
PORT=3000

# Persistent data directory (must already exist). Nothing writes to it yet.
DATA_DIR=./data

# development | production | test
NODE_ENV=development

# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# Interface the server listens on. With an http://localhost PUBLIC_ORIGIN the
# host process must listen on loopback (127.0.0.1 or ::1). The container image
# sets 0.0.0.0 and Compose publishes on 127.0.0.1 only.
LISTEN_HOST=127.0.0.1

# ---- Compose only (compose.yaml) ----
# Host port published on 127.0.0.1.
# HOST_PORT=3000
# Name of the persistent /data volume.
# CHATUI_VOLUME=chatui-data

# ---- llama.cpp provider (Phase 2) ----
# OpenAI-compatible llama-server base URL (no trailing path, no credentials).
# From inside the container, localhost is the container: use a LAN address,
# host.containers.internal (Podman) or host.docker.internal (see compose.yaml).
# LLAMA_BASE_URL=http://127.0.0.1:8080

# Secret API key for llama-server (--api-key). Never logged or sent to browsers.
# LLAMA_API_KEY=

# Inactivity timeout per provider request (to the first chunk and between
# chunks). Local models can take minutes to process a long prompt.
PROVIDER_TIMEOUT_MS=300000

# Cap on a whole generation.
GENERATION_MAX_MS=1800000

# Context window assumed when the provider does not report one.
DEFAULT_CONTEXT_TOKENS=8192

# max_tokens sent with every generation.
MAX_OUTPUT_TOKENS=4096

# Global limit on concurrently running generations. Unset = the provider's
# reported parallel slots (/props total_slots), else 1.
# MAX_ACTIVE_GENERATIONS=

# Maximum bytes accepted from the provider per response.
PROVIDER_MAX_RESPONSE_BYTES=16777216

# ---- Persistence (Phase 3) ----
# How long committed send-acceptance records are kept (idempotent retries).
OPERATION_RETENTION_MS=604800000

# Truncation anchor step in tokens; unset = 25% of the context budget.
# CONTEXT_TRIM_STEP=

# Per-message template overhead used when the provider cannot count tokens.
TEMPLATE_OVERHEAD_TOKENS=16

# ---- Accounts and sessions (Phase 4) ----
# The URL people open. Either http://localhost[:port] / http://127.0.0.1[:port]
# (this computer only), or an https:// URL served by a TLS-terminating proxy
# (Caddy, Tailscale HTTPS...). Any other http:// origin refuses to start.
# Default: http://localhost:<PORT>
# PUBLIC_ORIGIN=https://chat.example.com

# Reverse-proxy hops to trust for the client address (rate limiting). The
# protocol is never taken from X-Forwarded-Proto.
TRUST_PROXY=0

# closed (default): accounts are created with `npm run user:create`.
# open: anyone who can reach ChatUI may register.
REGISTRATION_MODE=closed

# Session lifetime (absolute) and inactivity timeout, in milliseconds.
SESSION_ABSOLUTE_TTL=2592000000
SESSION_IDLE_TTL=604800000

# Limits: running generations per user, open streams per user / in total,
# concurrent password hashes and their wait queue.
MAX_ACTIVE_GENERATIONS_PER_USER=2
MAX_SSE_PER_USER=8
MAX_SSE_TOTAL=256
PASSWORD_HASH_CONCURRENCY=2
PASSWORD_HASH_QUEUE=16

# ---- Providers (Phase 5) ----
# Providers live in DATA_DIR/_system/providers.json (see README). On first start
# it is created from LLAMA_BASE_URL / LLAMA_API_KEY; afterwards the file wins.

# SSRF policy for provider endpoints. Private and loopback hosts are allowed by
# default because a local llama.cpp server is the main use case.
ALLOW_PRIVATE_PROVIDER_HOSTS=true
# Optional: only these exact hostnames may be used (comma-separated).
# PROVIDER_HOST_ALLOWLIST=llm.lan,gpu-box.local
# Optional: exact link-local exceptions for a verified container host gateway,
# host=address:port (IPv6 in brackets). Cloud metadata addresses stay denied.
# PROVIDER_LINK_LOCAL_EXCEPTIONS=host.containers.internal=169.254.1.2:8080

# ---- Streaming (Phase 6) ----
# Running generations are checkpointed at most this often (plus every state
# change), so a restart can store the partial reply as "interrupted".
GENERATION_CHECKPOINT_MS=1000
# Finished generations stay re-observable (and their checkpoints are kept)
# this long.
GENERATION_RETENTION_MS=3600000
# Events kept per generation for reconnect replay. Older cursors get a full
# "resync" snapshot instead of a gap.
SSE_REPLAY_EVENTS=2000

# ---- Attachments (Phase 12) ----
# Admins can override the first four under Administration -> Settings.
ATTACHMENT_MAX_BYTES=20971520
# 1-10 attachments per message.
ATTACHMENT_MAX_PER_MESSAGE=10
# Attachment storage per user (bytes).
ATTACHMENT_QUOTA_BYTES=1073741824
# Text inlined into the prompt per text attachment; the rest is cut with a marker.
ATTACHMENT_TEXT_INLINE_BYTES=100000
# Uploads never sent with a message are removed after this long (ms).
ATTACHMENT_PENDING_TTL=86400000
# Largest accepted image, width x height.
ATTACHMENT_MAX_IMAGE_PIXELS=50000000
# Uploads in flight, per user and in total.
MAX_UPLOADS_PER_USER=4
MAX_UPLOADS_TOTAL=32
# Context tokens counted for each image or audio part (see docs/provider-notes.md).
MEDIA_TOKEN_RESERVE=1024

# Approved memories and proposal-only tools (Phase 13b).
# UTF-8 bytes of approved notes a prompt may include (whole notes; also capped at a quarter of the prompt budget).
MEMORY_PROMPT_BUDGET=4096
# Memory suggestion calls per reply, and the argument bytes per call; the rest are dropped as invalid.
MEMORY_TOOL_MAX_CALLS=4
MEMORY_TOOL_MAX_ARGUMENT_BYTES=8192
# Context tokens reserved for the one continuation after suggestions (tool-call and result messages).
CONTINUATION_TOKEN_RESERVE=256

# Source files captured from complete replies (Phase 13c; fences labelled file=<name>).
ARTIFACT_MAX_BYTES=262144
ARTIFACT_MAX_PER_REPLY=16
ARTIFACT_QUOTA_BYTES=104857600

# Portable import bounds (Phase 13d; ZIP-bomb and traversal guards are always on).
IMPORT_MAX_ARCHIVE_BYTES=1073741824
IMPORT_MAX_EXPANDED_BYTES=2147483648
IMPORT_MAX_ENTRIES=50000
IMPORT_MAX_RATIO=200
IMPORT_MAX_MS=600000
# Canonical records per import, and one foreign JSON document (Claude exports).
IMPORT_MAX_RECORDS=1000000
IMPORT_MAX_JSON_BYTES=268435456

# Per-user request budgets per minute (Phase 16; per process). Over budget: 429 + Retry-After.
# RATE_LIMIT_GENERATIONS_PER_MINUTE=30
# RATE_LIMIT_UPLOADS_PER_MINUTE=60
# RATE_LIMIT_ADMIN_PER_MINUTE=120
