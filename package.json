{
  "name": "chatui",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.21.0 <25"
  },
  "dependencies": {
    "@radix-ui/react-alert-dialog": "1.2.1",
    "@radix-ui/react-dialog": "1.3.1",
    "@radix-ui/react-dropdown-menu": "2.2.1",
    "@radix-ui/react-tooltip": "1.4.1",
    "@react-router/express": "8.4.0",
    "@react-router/node": "8.4.0",
    "@tanstack/react-query": "5.104.2",
    "argon2": "0.45.1",
    "express": "5.2.1",
    "helmet": "8.3.0",
    "highlight.js": "11.12.0",
    "ipaddr.js": "2.5.0",
    "isbot": "5.2.2",
    "katex": "0.19.0",
    "lucide-react": "1.57.0",
    "pino": "10.3.1",
    "pino-http": "11.0.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-markdown": "10.1.0",
    "react-router": "8.4.0",
    "remark-gfm": "4.0.1",
    "remark-math": "6.0.0",
    "undici": "8.12.3",
    "yaml": "2.9.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.63.0",
    "@react-router/dev": "8.4.0",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/express": "5.0.6",
    "@types/node": "24.19.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/supertest": "7.2.1",
    "eslint": "10.11.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-react-hooks": "7.1.1",
    "fast-check": "4.10.2",
    "globals": "17.12.0",
    "jsdom": "30.1.2",
    "prettier": "3.9.9",
    "supertest": "7.3.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.0",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  },
  "scripts": {
    "dev": "node scripts/dev.ts",
    "dev:server": "node --conditions=development --watch-path=server --watch-path=shared server/main.ts",
    "dev:client": "react-router typegen --watch",
    "build": "react-router build",
    "preview": "npm run build && npm start",
    "start": "NODE_ENV=production node server/main.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "react-router typegen && tsc",
    "lint": "react-router typegen && eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "verify": "npm run build && node scripts/perf-check.ts && node scripts/verify.ts",
    "verify:compose": "node scripts/verify-compose.ts",
    "index:rebuild": "node server/cli.ts index:rebuild",
    "user:create": "node server/cli.ts user:create",
    "user:reset-password": "node server/cli.ts user:reset-password",
    "test:e2e": "npm run build && playwright test",
    "demo": "node scripts/demo.ts",
    "perf:check": "node scripts/perf-check.ts"
  },
  "overrides": {
    "micromark-extension-math": {
      "katex": "$katex"
    }
  }
}
