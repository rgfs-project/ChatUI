{
  "name": "chatui",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.21.0 <25"
  },
  "dependencies": {
    "@react-router/express": "8.4.0",
    "@react-router/node": "8.4.0",
    "express": "5.2.1",
    "helmet": "8.3.0",
    "isbot": "5.2.2",
    "pino": "10.3.1",
    "pino-http": "11.0.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-router": "8.4.0",
    "yaml": "2.9.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.63.0",
    "@react-router/dev": "8.4.0",
    "@types/express": "5.0.6",
    "@types/node": "24.19.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/supertest": "7.2.1",
    "eslint": "10.11.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-react-hooks": "7.1.1",
    "fast-check": "4.10.2",
    "globals": "17.12.0",
    "prettier": "3.9.9",
    "supertest": "7.3.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.0",
    "vite": "8.3.1",
    "vitest": "5.0.2"
  },
  "scripts": {
    "dev": "node scripts/dev.ts",
    "dev:server": "node --conditions=development --watch-path=server --watch-path=shared server/main.ts",
    "dev:client": "react-router typegen --watch",
    "build": "react-router build",
    "preview": "npm run build && npm start",
    "start": "NODE_ENV=production node server/main.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "react-router typegen && tsc",
    "lint": "react-router typegen && eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "verify": "npm run build && node scripts/verify.ts",
    "verify:compose": "node scripts/verify-compose.ts",
    "index:rebuild": "node server/cli.ts index:rebuild"
  }
}
