    "@react-router/express": "8.4.0",
    "@react-router/node": "8.4.0",
    "@tanstack/react-query": "5.104.0",
    "argon2": "0.45.1",
    "busboy": "1.6.0",
    "express": "5.2.1",
    "get-nonce": "1.0.1",
    "hast-util-to-jsx-runtime": "2.3.6",
    "helmet": "8.3.0",
    "highlight.js": "11.12.0",
    "ipaddr.js": "2.5.0",
    "isbot": "5.2.2",
    "lowlight": "3.3.0",
    "lucide-react": "1.49.0",
    "mdast-util-from-markdown": "2.0.3",
    "mdast-util-gfm": "3.1.0",
    "mdast-util-math": "3.0.0",
    "micromark-extension-gfm": "3.0.0",
    "micromark-extension-math": "3.1.0",
    "pino": "10.3.1",
    "pino-http": "11.0.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-error-boundary": "6.1.6",
    "react-markdown": "10.1.0",
    "react-router": "8.4.0",
    "rehype-sanitize": "6.0.0",
    "temml": "0.13.5",
    "undici": "8.11.2",
    "yaml": "2.9.1",
    "yauzl": "3.4.0",
    "yazl": "3.3.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.63.0",
    "@react-router/dev": "8.4.0",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/busboy": "1.5.4",
    "@types/express": "5.0.6",
    "@types/node": "24.19.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/supertest": "7.2.1",
    "@types/yauzl": "3.4.0",
    "@types/yazl": "3.3.1",
    "eslint": "10.11.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-react-hooks": "7.1.1",
    "fast-check": "4.10.2",
    "globals": "17.12.0",
    "jsdom": "30.1.1",
    "prettier": "3.9.9",
    "remark-parse": "11.0.0",
    "supertest": "7.3.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.0",
    "vite": "8.3.1",
    "vitest": "5.0.3"
  },
  "scripts": {
    "dev": "node scripts/dev.ts",
    "dev:server": "node --conditions=development --watch-path=server --watch-path=shared server/main.ts",
    "dev:client": "react-router typegen --watch",
    "build": "react-router build && node scripts/compress-assets.ts",
    "preview": "npm run build && npm start",
    "start": "NODE_ENV=production node server/main.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "react-router typegen && tsc",
    "lint": "react-router typegen && eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "verify": "npm run build && node scripts/verify.ts",
    "verify:compose": "node scripts/verify-compose.ts",
    "index:rebuild": "node server/cli.ts index:rebuild",
    "user:create": "node server/cli.ts user:create",
    "test:e2e": "npm run build && playwright test",
    "perf:check": "node scripts/perf-check.ts",
    "perf:trace": "npm run build && node scripts/perf-trace.ts"
  }
}
